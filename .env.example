# Crie uma conta gratuita em https://www.themoviedb.org/ e gere uma API Key (v3 auth)
# em Configurações > API
TMDB_API_KEY=coloque_sua_chave_aqui

# String de conexão do PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/cinerank
DATABASE_URL="postgresql://usuario:senha@localhost:5432/cinerank"
